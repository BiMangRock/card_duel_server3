# .env.example — 내 컴퓨터에서 Supabase 에 붙여 볼 때 이 파일을 .env 로 복사해서 값을 채운다.
#   .env 는 비밀 값이라 GitHub 에 올리지 않는다 (.gitignore 에 들어 있음).
#   Vercel 에서는 이 파일 대신 프로젝트 Settings → Environment Variables 에 같은 이름으로 넣는다.
#   아무것도 안 넣으면: DB 는 data/pglite 폴더(내 컴퓨터), 실시간은 롱 폴링으로 그냥 돌아간다.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (포트 6543) 주소. [YOUR-PASSWORD] 를 DB 비밀번호로 바꾼다
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # anon public (또는 publishable) 키 — 브라우저에 보내도 되는 키
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # service_role (또는 secret) 키 — 절대 브라우저·GitHub 에 올리면 안 됨

# (선택) 카드 제안 AI
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
